# Copy to .env and adjust values:
#   cp .env.example .env

DB_URL=db:5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=numberlink
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP (transactional mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# From header; defaults to SMTP_USERNAME if empty
MAIL_FROM=
# Port 587: SMTP_STARTTLS=true, SMTP_SSL=false
# Port 465: SMTP_STARTTLS=false, SMTP_SSL=true
SMTP_STARTTLS=true
SMTP_SSL=false

# Optional avatar uploads (defaults in application.properties)
# UPLOADS_DIR=uploads
# AVATAR_MAX_BYTES=7340032

# Public URLs (OAuth redirects + email links). Local defaults are fine.
# FRONTEND_BASE_URL=http://localhost:7000
# BACKEND_BASE_URL=http://localhost:8000

# CORS Origin allowlist (comma-separated). Include local + production.
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://example.com,https://www.example.com

# Vite host check (Blocked request / allowedHosts).
# VITE_ALLOWED_HOSTS=example.com,www.example.com
